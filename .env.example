# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Provider keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Run with fake models instead (no keys, no API calls) - for demos and the dashboard
# GATEWAY_FAKE_PROVIDERS=1

# Bearer keys per app: "app:key,app:key". Unset = no auth, app from the X-App-Id header.
# GATEWAY_API_KEYS=web:change-me,batch:change-me-too

# Turns on the /admin endpoints (send it in the X-Admin-Key header)
# GATEWAY_ADMIN_KEY=change-me

# Alerts are POSTed here as JSON when set
# ALERT_WEBHOOK_URL=

# Elsewhere than the defaults
# GATEWAY_CONFIG=config/gateway.yaml
# GATEWAY_DB=var/gateway.db
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8000
