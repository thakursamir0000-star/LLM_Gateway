# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Provider keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Run with fake models instead (no keys, no API calls) - for demos and the dashboard
# GATEWAY_FAKE_PROVIDERS=1

# Bearer keys per app: "app:key,app:key". Fail-closed by default: required for /v1/chat/completions.
# GATEWAY_API_KEYS=web:change-me,batch:change-me-too

# Turns on the /admin endpoints (send it in the X-Admin-Key header; fail-closed when unset)
# GATEWAY_ADMIN_KEY=change-me

# Security settings (Phase 1 hardening)
# GATEWAY_ALLOW_ANONYMOUS=0       # 0 = fail closed (default); 1 = permit unauthenticated access via X-App-Id
# GATEWAY_MAX_BODY_BYTES=10485760 # Max request body size in bytes (default 10MB)
# GATEWAY_CORS_ORIGINS=           # Comma-separated allowed CORS origins (default empty / restrictive)
# GATEWAY_EXPOSE_METADATA=0       # 0 = clean OpenAI responses (default); 1 = expose internal gateway diagnostics/headers

# Alerts are POSTed here as JSON when set
# ALERT_WEBHOOK_URL=

# Elsewhere than the defaults
# GATEWAY_CONFIG=config/gateway.yaml
# GATEWAY_DB=var/gateway.db
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8000
